  "narrative": {
    "northStar": "The hardware study table",
    "overview": "A quiet, object-led explorer where the model carries the visual weight and one inspector explains the selected part. Pale green surfaces echo circuit-board materials without competing with the hardware. The original split-volume logo suggests looking inside a component.\n\nInteraction references are Lusion's 3D storytelling, Bruno Simon's direct object exploration, and NASA Eyes' selection/focus/detail loop. Their compositions are not copied. Further explanation, quizzes, and credits appear progressively to keep the workspace spacious.",
    "keyCharacteristics": [
      "A dominant model stage and a compact inspector.",
      "Dark green text, pale green surfaces, and restrained lime actions.",
      "Numbered selection shared by the model and component directory.",
      "Locally served Geist, flat surfaces, and circular viewer controls."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Reserve strong filled states for the current device, view, or component so selection stays legible.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** keep the model and one selected explanation visually dominant.",
      "**Do** keep selection synchronized between the model and directory.",
      "**Do** preserve visible keyboard focus and reduced-motion behavior.",
      "**Do** describe the photographic motherboard and representative geometry honestly."
    ],
    "donts": [
      "**Don't** add decorative marketing sections or repeated instructional panels to the explorer.",
      "**Don't** replace inline component numbers with decorative heading eyebrows.",
      "**Don't** enable continuous model motion by default.",
      "**Don't** present the motherboard reconstruction as an exact scan or CAD model."
    ]
  }
